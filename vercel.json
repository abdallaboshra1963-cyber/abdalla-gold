{
  "rewrites": [
    {
      "source": "/api/admin/login",
      "destination": "/api/admin?action=login"
    },
    {
      "source": "/api/admin/logout",
      "destination": "/api/admin?action=logout"
    },
    {
      "source": "/api/admin/data",
      "destination": "/api/admin?action=data"
    },
    {
      "source": "/api/admin/order-status",
      "destination": "/api/admin?action=order-status"
    },
    {
      "source": "/api/admin/settings",
      "destination": "/api/admin?action=settings"
    },
    {
      "source": "/owner",
      "destination": "/index.html"
    }
  ],
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}